DEFINE SCHEMA

    RECORD TYPE CD_AttemptRecord (
        CD_attemptID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cardID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cardID_ckAsset      ASSET,
        CD_correct             INT64 QUERYABLE SORTABLE,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_exerciseID          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_exerciseID_ckAsset  ASSET,
        CD_grade               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_grade_ckAsset       ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_transcript          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transcript_ckAsset  ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_EventRecord (
        CD_cardID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cardID_ckAsset      ASSET,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_eventID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_grade               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_grade_ckAsset       ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MockAttemptRecord (
        CD_answersJSON               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_answersJSON_ckAsset       ASSET,
        CD_attemptID                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_examID                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_examID_ckAsset            ASSET,
        CD_expired                   INT64 QUERYABLE SORTABLE,
        CD_finishedAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_form                      INT64 QUERYABLE SORTABLE,
        CD_moveReceipt               BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset       ASSET,
        CD_rubricJSON                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rubricJSON_ckAsset        ASSET,
        CD_sectionIndex              INT64 QUERYABLE SORTABLE,
        CD_sectionPointsJSON         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sectionPointsJSON_ckAsset ASSET,
        CD_sectionStartedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_startedAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_stateRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_stateRaw_ckAsset          ASSET,
        "___createTime"              TIMESTAMP,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PersonalWordRecord (
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_es                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_es_ckAsset           ASSET,
        CD_moveReceipt          BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset  ASSET,
        CD_ru                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ru_ckAsset           ASSET,
        CD_sourceCardID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceCardID_ckAsset ASSET,
        CD_wordID               STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RequestedItemRecord (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_itemID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_itemID_ckAsset      ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_requestedAt         TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ReviewRecord (
        CD_cardID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cardID_ckAsset      ASSET,
        CD_difficulty          DOUBLE QUERYABLE SORTABLE,
        CD_dueDate             TIMESTAMP QUERYABLE SORTABLE,
        CD_easeFactor          DOUBLE QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fsrsDueDate         TIMESTAMP QUERYABLE SORTABLE,
        CD_interval            INT64 QUERYABLE SORTABLE,
        CD_lastGrade           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lastGrade_ckAsset   ASSET,
        CD_lastReviewDate      TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_repetitions         INT64 QUERYABLE SORTABLE,
        CD_schedulerVersion    INT64 QUERYABLE SORTABLE,
        CD_stability           DOUBLE QUERYABLE SORTABLE,
        CD_statusRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset   ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SettingsRecord (
        CD_ccseDailyNewLimit              INT64 QUERYABLE SORTABLE,
        CD_celebratedLevels               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_celebratedLevels_ckAsset       ASSET,
        CD_dailyConjugationCount          INT64 QUERYABLE SORTABLE,
        CD_dailyNewCardCount              INT64 QUERYABLE SORTABLE,
        CD_dailyNewWordCount              INT64 QUERYABLE SORTABLE,
        CD_desiredRetention               DOUBLE QUERYABLE SORTABLE,
        CD_didCompleteOnboarding          INT64 QUERYABLE SORTABLE,
        CD_entityName                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_examDate                       TIMESTAMP QUERYABLE SORTABLE,
        CD_examDone                       INT64 QUERYABLE SORTABLE,
        CD_examKindRaw                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_examKindRaw_ckAsset            ASSET,
        CD_goalStartDate                  TIMESTAMP QUERYABLE SORTABLE,
        CD_goalStartIntroduced            INT64 QUERYABLE SORTABLE,
        CD_goalStateRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalStateRaw_ckAsset           ASSET,
        CD_goalTargetDate                 TIMESTAMP QUERYABLE SORTABLE,
        CD_goalTargetLevelRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalTargetLevelRaw_ckAsset     ASSET,
        CD_lastRecapWeek                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lastRecapWeek_ckAsset          ASSET,
        CD_moveReceipt                    BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset            ASSET,
        CD_personalWordIDs                BYTES QUERYABLE SORTABLE,
        CD_personalWordIDs_ckAsset        ASSET,
        CD_placementKnownLevelRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_placementKnownLevelRaw_ckAsset ASSET,
        CD_playAudioWhenSilent            INT64 QUERYABLE SORTABLE,
        CD_reminderMinutes                BYTES QUERYABLE SORTABLE,
        CD_reminderMinutes_ckAsset        ASSET,
        CD_remindersEnabled               INT64 QUERYABLE SORTABLE,
        CD_selectedDeckIDs                BYTES QUERYABLE SORTABLE,
        CD_selectedDeckIDs_ckAsset        ASSET,
        CD_selectedThemeIDs               BYTES QUERYABLE SORTABLE,
        CD_selectedThemeIDs_ckAsset       ASSET,
        CD_spanishVariantRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_spanishVariantRaw_ckAsset      ASSET,
        CD_speechRateRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_speechRateRaw_ckAsset          ASSET,
        CD_targetLevelRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_targetLevelRaw_ckAsset         ASSET,
        CD_variantPromptAnswered          INT64 QUERYABLE SORTABLE,
        "___createTime"                   TIMESTAMP,
        "___createdBy"                    REFERENCE,
        "___etag"                         STRING,
        "___modTime"                      TIMESTAMP,
        "___modifiedBy"                   REFERENCE,
        "___recordID"                     REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TrapPracticeRecord (
        CD_cardID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cardID_ckAsset      ASSET,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_eventID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_outcomeRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_outcomeRaw_ckAsset  ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
