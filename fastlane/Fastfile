require "time"
default_platform(:ios)

# App Store Connect API key. Prefer the on-disk .p8 (ASC_KEY_PATH) — it avoids a
# transporter base64-decoding bug in some fastlane builds; fall back to the
# base64 env var for local use.
def asc_api_key
  if ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
    )
  else
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
    )
  end
end

# Sentry dSYMs (crash-reporting): needs SENTRY_AUTH_TOKEN (an org token — it
# carries the EU region URL) and sentry-cli; skipped with a note otherwise, so
# local builds and forks still work.
def upload_dsyms_to_sentry
  if ENV["SENTRY_AUTH_TOKEN"].to_s.empty?
    UI.important("SENTRY_AUTH_TOKEN not set — skipping the Sentry dSYM upload")
    return
  end
  unless system("command -v sentry-cli > /dev/null")
    UI.important("sentry-cli not installed — skipping the Sentry dSYM upload")
    return
  end
  dsym = lane_context[SharedValues::DSYM_OUTPUT_PATH]
  if dsym.to_s.empty? || !File.exist?(dsym)
    UI.important("No dSYM archive from build_app — skipping the Sentry dSYM upload")
    return
  end
  org = ENV["SENTRY_ORG_SLUG"].to_s.empty? ? "lorito" : ENV["SENTRY_ORG_SLUG"]
  project = ENV["SENTRY_PROJECT_SLUG"].to_s.empty? ? "lorito" : ENV["SENTRY_PROJECT_SLUG"]
  sh("sentry-cli", "debug-files", "upload", "--org", org, "--project", project, dsym)
end

platform :ios do
  desc "Archive and export an App Store IPA (manual signing with existing dist cert)"
  lane :build do
    key = asc_api_key
    # App Store profiles for the app and both extensions. The archive is signed
    # manually with them and the imported Apple Distribution certificate:
    # automatic signing on a fresh runner creates a new Apple Development
    # certificate every run and hits the account's certificate limit.
    targets = {
      "Lorito" => ["com.toffguy.lorito", "lorito_appstore.mobileprovision"],
      "LoritoWidgets" => ["com.toffguy.lorito.widgets", "lorito_widgets_appstore.mobileprovision"],
      "LoritoLensAction" => ["com.toffguy.lorito.lens", "lorito_lens_appstore.mobileprovision"],
    }
    profiles = {}
    targets.each do |target, (bundle_id, filename)|
      get_provisioning_profile(api_key: key, app_identifier: bundle_id, output_path: "build", filename: filename)
      profiles[bundle_id] = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        path: "Lorito.xcodeproj",
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ["Release"],
        team_id: "3GWRDGA8B7",
        code_sign_identity: "Apple Distribution",
        profile_name: profiles[bundle_id],
      )
    end
    UI.message("Using profiles: #{profiles}")
    # App Store profiles carry the production push environment; the checked-in
    # entitlements say development (for Xcode runs). Archive with production.
    entitlements = File.expand_path("../Lorito/Lorito.entitlements")  # lanes run in fastlane/
    original = File.read(entitlements)
    File.write(entitlements, original.sub("<string>development</string>", "<string>production</string>"))
    begin
      build_app(
        project: "Lorito.xcodeproj",
        scheme: "Lorito",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build/ipa",
        output_name: "Lorito.ipa",
        clean: true,
        export_options: {
          signingStyle: "manual",
          teamID: "3GWRDGA8B7",
          provisioningProfiles: profiles,
        },
      )
    ensure
      File.write(entitlements, original)
    end
    upload_dsyms_to_sentry
  end

  desc "Upload the built IPA to TestFlight (no external distribution)"
  lane :upload do
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "build/ipa/Lorito.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  # Release after approval: scheduled for LORITO_RELEASE_AT (ISO 8601, e.g.
  # 2026-11-20T10:00:00+03:00; coordinated with featuring and the in-app event),
  # otherwise held for a manual release.
  def release_timing
    at = ENV["LORITO_RELEASE_AT"].to_s.strip
    return { automatic_release: false } if at.empty?
    { auto_release_date: (Time.iso8601(at).to_f * 1000).to_i }  # conflicts with automatic_release
  end

  desc "CI: import signing assets, build, upload to TestFlight (no review submission)"
  lane :ci_beta do
    # TestFlight also uses the production CloudKit schema — warn loudly.
    sh("bash", "../tools/cloudkit_schema_check.sh", "--warn")
    setup_ci
    import_certificate(
      certificate_path: "fastlane/certificate.p12",
      certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )
    build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "build/ipa/Lorito.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  desc "CI: import signing assets, build, upload to TestFlight, submit for review"
  lane :ci_release do
    # Metadata lint (limits, keyword rules; no exam terms before the exam path).
    sh("python3", "../tools/lint_metadata.py")
    # CloudKit release gate: production must have every development field.
    sh("bash", "../tools/cloudkit_schema_check.sh")
    setup_ci
    import_certificate(
      certificate_path: "fastlane/certificate.p12",
      certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )
    # Fresh iPhone + iPad screenshots on the runner's reliable simulators.
    capture_screenshots
    # Headlines over the raw captures → fastlane/screenshots/{ru,es-ES,es-MX}.
    Dir.chdir("..") { sh("swift", "tools/frame_screenshots.swift") }
    build  # downloads the App Store profiles, archives and exports with manual signing
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "build/ipa/Lorito.ipa",
      skip_waiting_for_build_processing: false,
      wait_for_uploaded_build: true,
      distribute_external: false,
    )
    deliver(
      api_key: asc_api_key,
      submit_for_review: true,
      force: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false },
      **release_timing,
    )
  end

  desc "Deliver metadata + screenshots and submit the version for review"
  lane :submit do
    # Metadata lint (limits, keyword rules; no exam terms before the exam path).
    sh("python3", "../tools/lint_metadata.py")
    # CloudKit release gate: production must have every development field.
    sh("bash", "../tools/cloudkit_schema_check.sh")
    deliver(
      api_key: asc_api_key,
      submit_for_review: true,
      force: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false },
      **release_timing,
    )
  end
end
