{
  "name": "Plumaje",
  "version": "1.0.0",
  "description": "Lorito design tokens. Source of truth for LoritoColor / LoritoFont / LoritoSpacing / LoritoRadius. Hex values are sRGB.",
  "color": {
    "surface":            { "light": "#F3F4EF", "dark": "#0F1A14", "note": "Papel — app background" },
    "surfaceRaised":      { "light": "#FFFFFF", "dark": "#17241C", "note": "Hoja — cards, sheets, rows" },
    "surfaceSunken":      { "light": "#E7EAE3", "dark": "#1C2A22", "note": "tracks, neutral buttons, inputs" },
    "separator":          { "light": "#DDE1DA", "dark": "#2A3B31" },

    "textPrimary":        { "light": "#0F1A14", "dark": "#F3F4EF" },
    "textSecondary":      { "light": "#56625B", "dark": "#A9B5AD", "note": "≥4.5:1 on surface in both themes" },
    "textTertiary":       { "light": "#66726B", "dark": "#8A968F", "note": "placeholders only, ≥4.5:1 on surfaceRaised" },

    "accent":             { "light": "#0E7C47", "dark": "#3BB273", "note": "Loro — primary brand green; also the Spanish-text color" },
    "onAccent":           { "light": "#FFFFFF", "dark": "#0F1A14" },
    "accentSoft":         { "light": "#E4F3EA", "dark": "#16301F" },
    "onAccentSoft":       { "light": "#0A5C35", "dark": "#9FD9B6" },

    "highlight":          { "light": "#CBEF6B", "dark": "#CBEF6B", "note": "Lima — primary CTA on ink, streak, success moments" },
    "onHighlight":        { "light": "#0F1A14", "dark": "#0F1A14" },

    "ink":                { "light": "#0F1A14", "dark": "#0F1A14", "note": "Tinta — hero cards; focus-mode background in both themes" },
    "onInk":              { "light": "#F3F4EF", "dark": "#F3F4EF" },
    "onInkSecondary":     { "light": "#A9B5AD", "dark": "#A9B5AD" },
    "inkRaised":          { "light": "#1C2A22", "dark": "#1C2A22", "note": "controls on ink" },
    "inkTrack":           { "light": "#33443A", "dark": "#33443A" },

    "danger":             { "light": "#E5482A", "dark": "#FF7A5C", "note": "Chile — glyphs, large marks; not for small text on light" },
    "dangerText":         { "light": "#B93519", "dark": "#FF9B85" },
    "dangerSoft":         { "light": "#FBE3DD", "dark": "#3A1F19" },

    "heat0":              { "light": "#E7EAE3", "dark": "#1C2A22" },
    "heat1":              { "light": "#9FD9B6", "dark": "#1E5A3A" },
    "heat2":              { "light": "#3BB273", "dark": "#2E9A60" },
    "heat3":              { "light": "#0A5C35", "dark": "#CBEF6B" }
  },
  "font": {
    "families": {
      "display": { "postscript": ["Unbounded-Bold", "Unbounded-ExtraBold"], "use": "screen titles, big numbers, brand glyphs ¡ ¿" },
      "ui":      { "postscript": ["Onest-Regular", "Onest-Medium", "Onest-SemiBold", "Onest-Bold"], "use": "all Russian UI and explanations" },
      "spanish": { "postscript": ["InstrumentSerif-Italic", "InstrumentSerif-Regular"], "use": "Spanish words, examples, answers — and nothing else" }
    },
    "styles": {
      "display":  { "family": "Unbounded-ExtraBold", "size": 44, "relativeTo": "largeTitle", "tracking": -1.5 },
      "title":    { "family": "Unbounded-ExtraBold", "size": 34, "relativeTo": "largeTitle", "tracking": -1.0 },
      "number":   { "family": "Unbounded-ExtraBold", "size": 64, "relativeTo": "largeTitle", "tracking": -2.0 },
      "heading":  { "family": "Unbounded-Bold",      "size": 22, "relativeTo": "title2",     "tracking": -0.5 },
      "bodyStrong": { "family": "Onest-SemiBold",    "size": 17, "relativeTo": "body" },
      "body":     { "family": "Onest-Regular",       "size": 17, "relativeTo": "body" },
      "caption":  { "family": "Onest-Medium",        "size": 13, "relativeTo": "footnote" },
      "label":    { "family": "Onest-Bold",          "size": 12, "relativeTo": "caption2", "tracking": 1.2, "uppercase": true },
      "spanish":  { "family": "InstrumentSerif-Italic", "size": 30, "relativeTo": "title" },
      "spanishInline": { "family": "InstrumentSerif-Italic", "size": 20, "relativeTo": "body" }
    }
  },
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "screenGutter": 20 },
  "radius":  { "sm": 14, "md": 20, "lg": 28, "xl": 36, "pill": 999 },
  "elevation": {
    "card":   { "color": "#0F1A14", "opacity": 0.12, "radius": 32, "y": 12 },
    "tabBar": { "color": "#0F1A14", "opacity": 0.12, "radius": 32, "y": 12 }
  },
  "layout": { "readingWidth": 640, "minTouchTarget": 44, "primaryButtonHeight": 56, "tabBarHeight": 64 },
  "appIcon": {
    "background": { "light": "#0E7C47", "dark": "#0F1A14", "tinted": "#000000" },
    "glyph": "¡ (Unbounded ExtraBold) — stem #CBEF6B, dot replaced by a circle #E5482A (the parrot's eye)",
    "sources": ["AppIcon.svg", "AppIcon-Dark.svg", "AppIcon-Tinted.svg"]
  }
}
